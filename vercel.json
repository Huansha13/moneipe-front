{
  "buildCommand": "ng build --configuration=production",
  "outputDirectory": "dist/moneype/browser",
  "framework": "angular",
  "installCommand": "pnpm install",
  "regions": ["iad1"],
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
